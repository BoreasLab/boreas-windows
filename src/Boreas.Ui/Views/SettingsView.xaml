<?xml version="1.0" encoding="utf-8"?>
<!--
    What this app does about its own appearance. Deliberately short, and
    deliberately separate from Network: nothing here travels over the control
    pipe or changes what the service does.

    The page states rather than offers. It holds no control because the app
    holds no appearance state: see SettingsView.xaml.cs.
-->
<Page
    x:Class="Boreas.Ui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Spacing="{StaticResource SpaceXl}" MaxWidth="640" HorizontalAlignment="Left">

            <StackPanel Spacing="{StaticResource SpaceXs}">
                <TextBlock Text="Settings" Style="{StaticResource DisplaySm}" />
                <TextBlock Style="{StaticResource BodyMd}" MaxWidth="560" HorizontalAlignment="Left"
                           Text="How this window looks. The tunnel is unaffected by anything on this page." />
            </StackPanel>

            <!--
                Appearance is stated, not chosen. A theme picker stores a
                decision that outlives the moment it was made: choose Dark
                once, switch Windows to light later, and the window stays dark
                with the explanation two pages away. Following the system has
                no such failure, so it is what happens, and this says so.
            -->
            <StackPanel Spacing="{StaticResource SpaceSm}">
                <TextBlock Text="Appearance" Style="{StaticResource TitleMd}" />
                <TextBlock Style="{StaticResource BodyMd}" MaxWidth="560" HorizontalAlignment="Left"
                           Text="Boreas follows the light or dark appearance set in Windows, and changes with it. Change it under Settings, Personalisation, Colours." />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
