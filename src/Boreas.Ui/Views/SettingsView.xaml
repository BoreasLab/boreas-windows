<?xml version="1.0" encoding="utf-8"?>
<!--
    This app's own preferences. Deliberately short, and deliberately separate
    from Network: nothing here travels over the control pipe or changes what
    the service does.
-->
<Page
    x:Class="Boreas.Ui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Spacing="{StaticResource SpaceXl}" MaxWidth="640" HorizontalAlignment="Left">

            <StackPanel Spacing="{StaticResource SpaceXs}">
                <TextBlock Text="Settings" Style="{StaticResource DisplaySm}" />
                <TextBlock Style="{StaticResource BodyMd}" MaxWidth="560" HorizontalAlignment="Left"
                           Text="How this window looks. The tunnel is unaffected by anything on this page." />
            </StackPanel>

            <StackPanel Spacing="{StaticResource SpaceLg}">
                <TextBlock Text="Appearance" Style="{StaticResource TitleMd}" />

                <!-- Following Windows is the default, and it is first, because
                     it is right for almost everyone. -->
                <RadioButtons Header="Theme"
                              SelectedIndex="{x:Bind ThemeIndex, Mode=TwoWay}">
                    <RadioButton Content="Follow Windows" />
                    <RadioButton Content="Light" />
                    <RadioButton Content="Dark" />
                </RadioButtons>

                <TextBlock Style="{StaticResource FieldHint}" Margin="0"
                           Text="Applied immediately and remembered for next time." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
