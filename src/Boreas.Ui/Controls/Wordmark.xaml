<?xml version="1.0" encoding="utf-8"?>
<!--
    PROVISIONAL MARK. Drawn here so the title bar is not empty, and drawn from
    scratch so it borrows nobody's identity. Two stacked chevrons, north: the
    plainest reading of the name.

    This is a labelled slot, not finished brand work. Replace it with the real
    Boreas mark as an SVG asset when one exists; the only thing depending on
    its shape is this file.
-->
<UserControl
    x:Class="Boreas.Ui.Controls.Wordmark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <StackPanel Orientation="Horizontal"
                Spacing="{StaticResource SpaceXs}"
                VerticalAlignment="Center"
                AutomationProperties.Name="Boreas"
                AutomationProperties.AccessibilityView="Content">

        <Canvas Width="16" Height="16" VerticalAlignment="Center">
            <Path Stroke="{ThemeResource AccentText}"
                  StrokeThickness="1.75"
                  StrokeLineJoin="Miter"
                  Data="M 2,7 L 8,1.5 L 14,7" />
            <Path Stroke="{ThemeResource TextPrimary}"
                  StrokeThickness="1.75"
                  StrokeLineJoin="Miter"
                  Data="M 2,14 L 8,8.5 L 14,14" />
        </Canvas>

        <TextBlock Text="Boreas"
                   Style="{StaticResource TitleSm}"
                   VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
