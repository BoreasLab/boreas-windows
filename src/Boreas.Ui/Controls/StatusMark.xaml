<?xml version="1.0" encoding="utf-8"?>
<!--
    One mark for every status in the application: the ring on the band, the dot
    in the title-bar chip, the icon on a banner.

    Two closed axes, and both are needed. Tone is what the mark means. Surface
    is which ground it sits on, and it exists because the status band is dark
    in both themes while the chip and the banner sit on the cream canvas: one
    tone family cannot be legible on both. BandTone* and Status* carry the same
    four meanings for the two grounds, and tests/Boreas.Ui.Tests measures each
    family against the surface it is declared for.

    Tone is a visual state rather than a converter so the brushes stay
    ThemeResource lookups. A converter would capture a brush at bind time and
    would not follow a theme change.

    The mark is never the only carrier of a status. Everywhere it appears the
    state is also written next to it in words, which is why it is raw to
    assistive technology: announcing it too would say the state twice.
-->
<UserControl
    x:Class="Boreas.Ui.Controls.StatusMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <Grid x:Name="Root"
          Width="{x:Bind Diameter, Mode=OneWay}"
          Height="{x:Bind Diameter, Mode=OneWay}">

        <Ellipse x:Name="Ring"
                 StrokeThickness="{x:Bind RingThickness, Mode=OneWay}"
                 Stroke="{ThemeResource StatusIdle}" />

        <ProgressRing x:Name="Busy"
                      IsActive="False"
                      Visibility="Collapsed"
                      Foreground="{ThemeResource StatusIdle}"
                      Width="{x:Bind Diameter, Mode=OneWay}"
                      Height="{x:Bind Diameter, Mode=OneWay}" />

        <FontIcon x:Name="Mark"
                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                  Glyph="{x:Bind Glyph, Mode=OneWay}"
                  FontSize="{x:Bind GlyphSize, Mode=OneWay}"
                  Foreground="{ThemeResource StatusIdle}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToneStates">

                <!-- On the cream canvas and cream cards. -->
                <VisualState x:Name="CanvasIdle" />

                <VisualState x:Name="CanvasActive">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource StatusActive}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource StatusActive}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource StatusActive}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="CanvasCaution">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource StatusCaution}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource StatusCaution}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource StatusCaution}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="CanvasFault">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource StatusFault}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource StatusFault}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource StatusFault}" />
                    </VisualState.Setters>
                </VisualState>

                <!-- On the dark band, in either theme. -->
                <VisualState x:Name="BandIdle">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource BandToneIdle}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource BandToneIdle}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource BandToneIdle}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="BandActive">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource BandToneActive}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource BandToneActive}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource BandToneActive}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="BandCaution">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource BandToneCaution}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource BandToneCaution}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource BandToneCaution}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="BandFault">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource BandToneFault}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource BandToneFault}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource BandToneFault}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
