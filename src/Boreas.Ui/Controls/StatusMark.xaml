<?xml version="1.0" encoding="utf-8"?>
<!--
    One mark for every status in the application: the ring on the band, the
    dot in the title-bar chip, the icon on a banner. Tone is its single axis
    of identity; diameter and glyph size are position, not identity.

    Tone is expressed as a visual state rather than a converter so the brushes
    are ThemeResource lookups. A converter would return a brush captured at
    bind time and would not follow a theme change.

    The mark is never the only carrier of a status. Every place it appears,
    the state is also written next to it in words, which is why it is raw to
    assistive technology: announcing it too would say the state twice.
-->
<UserControl
    x:Class="Boreas.Ui.Controls.StatusMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <Grid x:Name="Root"
          Width="{x:Bind Diameter, Mode=OneWay}"
          Height="{x:Bind Diameter, Mode=OneWay}">

        <Ellipse x:Name="Ring"
                 StrokeThickness="{x:Bind RingThickness, Mode=OneWay}"
                 Stroke="{ThemeResource StatusIdle}"
                 Fill="{x:Bind FillBrush, Mode=OneWay}" />

        <ProgressRing x:Name="Busy"
                      IsActive="False"
                      Visibility="Collapsed"
                      Foreground="{ThemeResource StatusIdle}"
                      Width="{x:Bind Diameter, Mode=OneWay}"
                      Height="{x:Bind Diameter, Mode=OneWay}" />

        <FontIcon x:Name="Mark"
                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                  Glyph="{x:Bind Glyph, Mode=OneWay}"
                  FontSize="{x:Bind GlyphSize, Mode=OneWay}"
                  Foreground="{ThemeResource StatusIdle}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Idle" />

                <VisualState x:Name="Active">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource StatusActive}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource StatusActive}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource StatusActive}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource StatusCaution}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource StatusCaution}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource StatusCaution}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Fault">
                    <VisualState.Setters>
                        <Setter Target="Ring.Stroke" Value="{ThemeResource StatusFault}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource StatusFault}" />
                        <Setter Target="Busy.Foreground" Value="{ThemeResource StatusFault}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
