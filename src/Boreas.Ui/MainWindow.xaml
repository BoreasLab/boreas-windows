<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Boreas.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Boreas.Ui.Controls">

    <Grid x:Name="Shell" Background="{ThemeResource SurfaceCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ TITLE BAR ============================
             Content is extended into the caption area, so the branded canvas
             runs to the top of the window instead of stopping under a system
             bar in a different colour.

             Everything in here is non-interactive on purpose: the whole strip
             is the drag region, and a button inside a drag region is a button
             that sometimes moves the window instead of activating.

             The channel chip lives here rather than in the page because it is
             true of the whole application, and because a strip that is always
             present never causes the layout below it to move. -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Height="48"
              Padding="16,0,0,0"
              ColumnSpacing="{StaticResource SpaceSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInset" Width="0" />
            </Grid.ColumnDefinitions>

            <controls:Wordmark Grid.Column="0" VerticalAlignment="Center" />

            <!-- Compiled out of release builds along with the sample channel.
                 While it is here, nothing on screen is a measurement. -->
            <Border x:Name="SampleMarker"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Background="{ThemeResource SurfaceSunken}"
                    CornerRadius="{StaticResource RadiusPill}"
                    Padding="{StaticResource PadPill}"
                    VerticalAlignment="Center">
                <TextBlock Text="Sample data"
                           Style="{StaticResource CaptionText}"
                           Foreground="{ThemeResource TextPrimary}" />
            </Border>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceXs}"
                        VerticalAlignment="Center"
                        Padding="0,0,16,0">
                <controls:StatusMark x:Name="ChannelDot"
                                     Diameter="10"
                                     RingThickness="5"
                                     VerticalAlignment="Center" />
                <TextBlock x:Name="ChannelLabel"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============================ NAVIGATION ============================
             A left pane, because there are peer sections rather than views of
             one object, and because that is where Windows applications put
             them. Every page title matches its entry here exactly. -->
        <muxc:NavigationView x:Name="Navigation"
                             Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="212"
                             SelectionChanged="OnNavigationSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Status" Tag="status" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="Network" Tag="network">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="Diagnostics" Tag="diagnostics">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="Settings" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="About" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Grid RowSpacing="{StaticResource SpaceMd}" Padding="{StaticResource PadView}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The channel banner sits above the page, not over it, so it
                     never covers a focused control. It appears only when the
                     channel needs something done about it; the chip above
                     already carries the routine case. -->
                <controls:Banner x:Name="ChannelBanner"
                                 Grid.Row="0"
                                 Visibility="Collapsed" />

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
