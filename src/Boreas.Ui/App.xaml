<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Boreas.Ui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The platform's control styles first, then this
                     application's tokens, then the components built on them.
                     Order matters: the token aliases in Tokens.xaml repaint
                     the platform's controls, so they must be merged after. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Design/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Design/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
