<?xml version="1.0" encoding="utf-8"?>
<!--
    The primitive layer: type ramp, one button template, surfaces, fields.
    Every value here comes from Tokens.xaml. Nothing below this file defines a
    colour, a size, a space or a radius.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Boreas.Ui.Converters">

    <!-- One visibility mechanism for the whole application. -->
    <converters:BoolToVisibility x:Key="Visible" />

    <!-- ============================== TYPE ==============================
         Nine steps, used exactly as declared. The serif carries the two
         display steps and nothing else; chrome is the platform sans, which
         is what every other Windows application uses and therefore what
         costs a reader the least. -->

    <Style x:Key="DisplayMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource TypeDisplayMd}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="42" />
        <!-- Negative tracking on display sizes is the supplied document's
             one non-negotiable typographic rule. -->
        <Setter Property="CharacterSpacing" Value="-14" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <Style x:Key="DisplaySm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource TypeDisplaySm}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="CharacterSpacing" Value="-11" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
    </Style>

    <Style x:Key="TitleLg" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeTitleLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="29" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
    </Style>

    <Style x:Key="TitleMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeTitleMd}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="25" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
    </Style>

    <Style x:Key="TitleSm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeTitleSm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
    </Style>

    <Style x:Key="BodyMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodyMd}" />
        <Setter Property="LineHeight" Value="25" />
        <Setter Property="Foreground" Value="{ThemeResource TextBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodySm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySm}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource TextBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
    </Style>

    <!-- Uppercase runs lose word shape, so this is for two-word labels only,
         and there is at most one per group of sections. -->
    <Style x:Key="CaptionUpper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionUpper}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
    </Style>

    <!-- Identifiers, addresses and counters. Tabular by construction, so
         digits do not shift as a counter ticks. -->
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCode}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- ========================= ON THE DARK BAND =========================
         The band keeps its own foregrounds because it is dark in both
         themes. These are the only styles that name band colours. -->

    <Style x:Key="BandDisplay" TargetType="TextBlock" BasedOn="{StaticResource DisplayMd}">
        <Setter Property="Foreground" Value="{ThemeResource BandInk}" />
    </Style>

    <Style x:Key="BandBody" TargetType="TextBlock" BasedOn="{StaticResource BodyMd}">
        <Setter Property="Foreground" Value="{ThemeResource BandInkSoft}" />
    </Style>

    <Style x:Key="BandCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{ThemeResource BandInkSoft}" />
    </Style>

    <Style x:Key="BandMono" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
        <Setter Property="Foreground" Value="{ThemeResource BandInk}" />
    </Style>

    <!-- ============================= SURFACES =============================
         Space, then alignment, then a hairline, then a tint. A card is used
         only for a discrete object a person acts on as a unit. -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceCard}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource PadCard}" />
    </Style>

    <Style x:Key="OutlinedCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceCanvas}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource PadCard}" />
    </Style>

    <Style x:Key="Band" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBand}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="{StaticResource PadBand}" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource Hairline}" />
    </Style>

    <!-- ============================== BUTTON ==============================
         One template for every variant. The variant supplies the fill, the
         label colour and the border; the template supplies the geometry, the
         press feedback and the focus visual. There is no second button.

         Press feedback is a tint over whatever the fill is, which is why
         adding a variant needs no template change and cannot invent its own
         interaction behaviour. -->

    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Grid x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="Overlay"
                    Opacity="0"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{ThemeResource OverlayHover}" />

            <ContentPresenter x:Name="Presenter"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              AutomationProperties.AccessibilityView="Raw" />

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />

                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>

                    <!-- Acknowledged at press, before any work starts. -->
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Opacity" Value="1" />
                            <Setter Target="Overlay.Background" Value="{ThemeResource OverlayPress}" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceSunken}" />
                            <Setter Target="Root.BorderBrush" Value="{ThemeResource Hairline}" />
                            <Setter Target="Presenter.Foreground" Value="{ThemeResource TextDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource PadControl}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{ThemeResource AccentFill}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentOn}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceCanvas}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorder}" />
    </Style>

    <!-- On the band, secondary stays dark. The system never inverts to a
         light secondary on a dark surface. -->
    <Style x:Key="SecondaryOnBandButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{ThemeResource SurfaceBandRaised}" />
        <Setter Property="Foreground" Value="{ThemeResource BandInk}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Danger is its own colour so a destructive action does not read as the
         accent. It is placed away from the frequent action, never focused by
         default. -->
    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{ThemeResource DangerFill}" />
        <Setter Property="Foreground" Value="{ThemeResource DangerOn}" />
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AccentText}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- ========================= PENDING INDICATOR =========================
         Always laid out, only sometimes spinning, so a control never resizes
         when it starts working and its label never disappears. -->
    <Style x:Key="InlinePending" TargetType="ProgressRing">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource AccentOn}" />
    </Style>

    <Style x:Key="InlinePendingOnCanvas" TargetType="ProgressRing" BasedOn="{StaticResource InlinePending}">
        <Setter Property="Foreground" Value="{ThemeResource AccentText}" />
    </Style>

    <!-- ============================== FIELDS ==============================
         Label above the field, never a placeholder standing in for one. -->

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TitleSm}">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
    </Style>

    <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource BodySm}">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="MaxWidth" Value="520" />
    </Style>

    <!-- The message sits next to its cause and names the fix. Colour is not
         the only channel: the message is text, and it is announced. -->
    <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource BodySm}">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Foreground" Value="{ThemeResource DangerText}" />
        <Setter Property="MaxWidth" Value="520" />
    </Style>

    <Style x:Key="FieldInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodyMd}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MaxWidth" Value="400" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="FieldInputMono" TargetType="TextBox" BasedOn="{StaticResource FieldInput}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCode}" />
    </Style>

</ResourceDictionary>
