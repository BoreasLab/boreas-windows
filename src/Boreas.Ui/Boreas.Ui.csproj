<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Boreas.Ui</RootNamespace>
    <AssemblyName>Boreas</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged. The product installer places the app beside the native
         service; there is no separate MSIX identity to maintain. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!--
    One knob. The platform and the runtime identifier are the same fact stated
    twice, and stated twice they can disagree: a self-contained build with no
    explicit RID infers the *agent's* RID, so building ARM64 on an x64 agent
    inferred win-x64 against PlatformTarget arm64 and the SDK rejected the pair
    (NETSDK1032). Deriving the RID from the platform makes that pair
    unrepresentable rather than merely unlikely, and callers pass -p:Platform
    alone.

    Routed through a second property rather than by reassigning Platform.
    Platform arrives from the command line as an MSBuild global property, and a
    global property cannot be overridden from inside the project, so a
    condition on Platform itself silently does nothing for exactly the values
    it was written to catch. The AnyCPU defaults are not among this project's
    platforms and would name a RID that does not exist, so a bare `dotnet
    build` or a solution mapping lands on x64.
  -->
  <PropertyGroup>
    <BoreasPlatform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</BoreasPlatform>
    <BoreasPlatform Condition="'$(BoreasPlatform)' == ''">$(Platform)</BoreasPlatform>
    <RuntimeIdentifier>win-$(BoreasPlatform.ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    The two native libraries, at the versions scripts/fetch-native.sh pins.

    Referenced from where that script extracted them, never copied into the
    tree: boreas.dll is thirteen megabytes per architecture, it is reproducible
    from a pinned tag, and a binary committed here is one whose provenance
    nobody can check afterwards.

    One knob again. BoreasPlatform already decides the runtime identifier, and
    it decides these too, so the architecture is stated once. The two vendors
    spell it differently - .NET says win-x64 and Wintun's archive says amd64 -
    and that translation lives here rather than in a build command somebody has
    to remember.
  -->
  <PropertyGroup>
    <BoreasNativeRoot>$(MSBuildThisFileDirectory)..\..\native\</BoreasNativeRoot>
    <BoreasWintunArch Condition="'$(BoreasPlatform)' == 'x64'">amd64</BoreasWintunArch>
    <BoreasWintunArch Condition="'$(BoreasWintunArch)' == ''">$(BoreasPlatform.ToLowerInvariant())</BoreasWintunArch>
    <BoreasDll>$(BoreasNativeRoot)boreas\runtimes\$(RuntimeIdentifier)\native\boreas.dll</BoreasDll>
    <WintunDll>$(BoreasNativeRoot)wintun\bin\$(BoreasWintunArch)\wintun.dll</WintunDll>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(BoreasDll)" Link="boreas.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WintunDll)" Link="wintun.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    A missing native library is a runtime failure on a machine nobody is
    watching, and the message it produces names a DLL rather than the step that
    was skipped. Failing the build instead costs one condition and names the
    command.
  -->
  <Target Name="BoreasRequireNativeLibraries" BeforeTargets="Build">
    <Error Condition="!Exists('$(BoreasDll)')"
           Text="boreas.dll is missing for $(RuntimeIdentifier). Run scripts/fetch-native.sh, which downloads it at the pinned tag and verifies its build provenance." />
    <Error Condition="!Exists('$(WintunDll)')"
           Text="wintun.dll is missing for $(BoreasWintunArch). Run scripts/fetch-native.sh." />
  </Target>

  <!-- What this build composed with, readable at runtime. There is no dedicated
       attribute for "the dependency this was built against", and a file holding
       it would be a second thing to keep in step with the pin. -->
  <ItemGroup>
    <AssemblyMetadata Include="BoreasCoreTag" Value="$(BoreasCoreTag)" />
    <AssemblyMetadata Include="BoreasPosition" Value="$(BoreasPosition)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <!-- The C ABI, the two vtables, and the tunnel lifecycle. Targets plain
       net10.0 so its layout laws run wherever this repository builds. -->
  <ItemGroup>
    <ProjectReference Include="../Boreas.Interop/Boreas.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Design\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>

</Project>
